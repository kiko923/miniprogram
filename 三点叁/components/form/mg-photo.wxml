      wx:key="i"
    >
      <view
        class="mpimg o-h data-v-0d675383"
        style="{{'width:'+w+';'+'height:'+w+';'}}"
      >
        <mg-img
          bind:__l="__l"
          class="data-v-0d675383"
          local="{{v.tmp}}"
