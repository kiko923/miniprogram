<view class="mh100 data-v-90862d88" hidden="{{!dlDatl.id}}">
  <view class="ptb7 cf data-v-90862d88" style="{{'background:'+tColor+';'}}">
    <view class="f-bt data-v-90862d88">
      <view class="f32 data-v-90862d88" wx:if="{{dlDatl.state=='1'}}"
        >未付款</view
      >
      <view
        class="f32 data-v-90862d88"
        wx:if="{{dlDatl.deliveryMode=='1'&&dlDatl.state=='2'}}"
        >待发货</view
      >
      <view
        class="f32 data-v-90862d88"
        wx:if="{{dlDatl.deliveryMode=='2'&&dlDatl.state=='2'}}"
        >待核销</view
      >
      <view class="f32 data-v-90862d88" wx:if="{{dlDatl.state=='3'}}"
        >已发货</view
      >
      <view class="f32 data-v-90862d88" wx:if="{{dlDatl.state=='4'}}"
        >已完成</view
      >
      <view class="data-v-90862d88">
        <text class="iconfont iconddys mr10 f60 cf data-v-90862d88"></text>
      </view>
    </view>
    <view
      class="f32 mt20 data-v-90862d88"
      wx:if="{{dlDatl.goodsType=='1'&&dlDatl.deliveryMode=='2'}}"
      >{{'核销码：'+dlDatl.selfCode}}</view
    >
  </view>
  <view class="m23 data-v-90862d88">
    <view
      class="bf bs20 f24 p32 f-bt mb20 data-v-90862d88"
      wx:if="{{dlDatl.goodsType=='1'}}"
    >
      <view class="f-g-0 mr20 data-v-90862d88">
        <view
          class="yuan f-c data-v-90862d88"
          style="{{'background:'+tColor+';'}}"
        >
          <text
            class="iconfont iconditu mr10 f42 cf ml10 data-v-90862d88"
          ></text>
        </view>
      </view>
      <view class="f-g-1 data-v-90862d88">
        <view class="f28 c3 data-v-90862d88">
          <text class="f32 mr20 data-v-90862d88">{{dlDatl.receiveName}}</text>
          <text class="c9 data-v-90862d88">{{dlDatl.receiveTel}}</text>
        </view>
        <view class="f28 t-o-e2 mt0 data-v-90862d88"
          >{{dlDatl.receiveAddress}}</view
        >
      </view>
    </view>
    <view class="f28 bf bs20 p32 c3 mb20 data-v-90862d88">
      <view class="f-row data-v-90862d88">
        <view class="f-g-0 mr30 data-v-90862d88">
          <view class="imgw bs10 bf7 data-v-90862d88">
            <mg-img
              bind:__l="__l"
              class="data-v-90862d88"
              src="{{dlDatl.goodsIcon}}"
              vueId="28b243ce-1"
            ></mg-img>
          </view>
        </view>
        <view class="f-g-1 f-y-bt data-v-90862d88">
          <view class="wei4 f30 t-o-e2 c6 data-v-90862d88"
            >{{dlDatl.goodsName}}</view
          >
          <view class="f-x-bt data-v-90862d88">
            <view class="cfa t-o-e wei4 data-v-90862d88">
              <text class="data-v-90862d88" wx:if="{{dlDatl.score>=0}}"
                >{{dlDatl.score}}</text
              >
              <text
                class="f26 ml10 nowei data-v-90862d88"
                wx:if="{{dlDatl.score>=0}}"
                >{{jfName}}</text
              >
              <text
                class="nowei data-v-90862d88"
                wx:if="{{dlDatl.score>=0&&dlDatl.money>=0}}"
                >+</text
              >
              <text class="data-v-90862d88" wx:if="{{dlDatl.money>=0}}">
                <text class="f22 data-v-90862d88">{{sl}}</text
                >{{dlDatl.money}}</text
              >
            </view>
          </view>
        </view>
      </view>
      <view class="f-bt mt20 data-v-90862d88">
        <view class="data-v-90862d88">购买数量</view>
        <view class="data-v-90862d88">{{'x'+dlDatl.convertNum}}</view>
      </view>
      <view class="f-bt mt20 data-v-90862d88">
        <view class="data-v-90862d88">商品类型</view>
        <view class="data-v-90862d88"
          >{{dlDatl.goodsType==1?'实物':'虚拟'}}</view
        >
      </view>
      <view
        class="f-bt mt20 data-v-90862d88"
        wx:if="{{dlDatl.goodsType=='1'&&dlDatl.deliveryMode!='0'}}"
      >
        <view class="f-g-0 mr30 data-v-90862d88">配送方式</view>
        <view
          class="f-g-1 f-bt data-v-90862d88"
          wx:if="{{dlDatl.deliveryMode=='1'}}"
        >
          <view class="c9 data-v-90862d88">快递配送</view>
          <view class="data-v-90862d88" style="{{'color:'+tColor+';'}}"
            >{{dlDatl.deliveryMoney>=0?'运费:'+sl+dlDatl.deliveryMoney:'免邮'}}</view
          >
        </view>
        <view
          class="f-g-1 data-v-90862d88"
          wx:if="{{dlDatl.deliveryMode=='2'}}"
        >
          <view class="c9 data-v-90862d88">到店自取</view>
        </view>
      </view>
      <view class="wei4 cfa f-x-e mt20 mb20 line24 data-v-90862d88">
        <text class="c3 data-v-90862d88">实付：</text>
        <text class="data-v-90862d88" wx:if="{{dlDatl.score>=0}}"
          >{{dlDatl.score}}</text
        >
        <text class="f26 ml10 nowei data-v-90862d88" wx:if="{{dlDatl.score>=0}}"
          >{{jfName}}</text
        >
        <text
          class="nowei data-v-90862d88"
          wx:if="{{dlDatl.score>=0&&dlDatl.money>=0}}"
          >+</text
        >
        <text class="data-v-90862d88" wx:if="{{dlDatl.money>=0}}">
          <text class="f22 data-v-90862d88">{{sl}}</text>{{dlDatl.money}}</text
        >
      </view>
      <mg-cell
        bgc="#FAFBFC"
        bind:__l="__l"
        bind:tab="__e"
        class="data-v-90862d88"
        cname="b-t-e"
        data-event-opts="{{[ [ '^tab',[ [ 'go',[ [ 'o',['url','/yb_wm/my/other/kf'] ] ] ] ] ] ]}}"
        last="1"
        vueId="28b243ce-2"
        vueSlots="{{['bd']}}"
        wx:if="{{dlDatl.goodsType=='1'}}"
      >
        <view class="data-v-90862d88" slot="bd">
          <view class="f30 f-c data-v-90862d88">
            <text class="iconfont f42 icondh1 c0 mr20 data-v-90862d88"></text>
            <text class="t-o-e data-v-90862d88">联系平台</text>
          </view>
        </view>
      </mg-cell>
    </view>
    <view class="f28 bf bs20 p32 c3 mb20 data-v-90862d88">
      <view class="f32 data-v-90862d88">订单信息</view>
      <view class="f-bt mt20 data-v-90862d88">
        <view class="f-g-0 mr30 data-v-90862d88">订单编号</view>
        <view class="f-g-1 c6 data-v-90862d88">{{dlDatl.outTradeNo}}</view>
      </view>
      <view class="f-bt mt20 data-v-90862d88">
        <view class="f-g-0 mr30 data-v-90862d88">支付时间</view>
        <view class="f-g-1 c6 data-v-90862d88">{{$root.m0}}</view>
      </view>
      <view class="f-bt mt20 data-v-90862d88" wx:if="{{dlDatl.logisticsName}}">
        <view class="f-g-0 mr30 data-v-90862d88">快递名称</view>
        <view class="f-g-1 c6 data-v-90862d88">{{dlDatl.logisticsName}}</view>
      </view>
      <view class="f-bt mt20 data-v-90862d88" wx:if="{{dlDatl.logisticsCode}}">
        <view class="f-g-0 mr30 data-v-90862d88">快递单号</view>
        <view class="f-g-1 c6 data-v-90862d88">{{dlDatl.logisticsCode}}</view>
      </view>
      <view class="f-bt mt20 data-v-90862d88" wx:if="{{dlDatl.payMode>0}}">
        <view class="f-g-0 mr30 data-v-90862d88">支付方式</view>
        <view class="f-g-1 c6 data-v-90862d88">{{$root.m1}}</view>
      </view>
    </view>
  </view>
</view>
