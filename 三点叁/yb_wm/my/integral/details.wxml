      </view>
      <view class="data-v-198e8b62">
        <view
          class="f24 c9 data-v-198e8b62"
          wx:if="{{dlDatl.stock-dlDatl.convertNum>-1}}"
          >{{'剩余'+dlDatl.stock-dlDatl.convertNum+'件'}}</view
