  <tcyhq
    bind:__l="__l"
    bind:close="__e"
    bind:input="__e"
    class="data-v-98d38686"
    co="{{xkzxInfo}}"
    color="{{tColor}}"
    data-event-opts="{{[ [ '^close',[ ['e0'] ] ],[ '^input',[ [ '__set_model',[ '','xkzxshow','$event',[] ] ] ] ] ]}}"
    type="3"
    value="{{xkzxshow}}"
    vueId="1de1c492-30"
    wx:if="{{xkzxInfo}}"
  ></tcyhq>
  <tcyhq
    bind:__l="__l"
    bind:close="__e"
    bind:input="__e"
    class="data-v-98d38686"
    co="{{fqbInfo}}"
    data-event-opts="{{[ [ '^close',[ ['e1'] ] ],[ '^input',[ [ '__set_model',[ '','fqbshow','$event',[] ] ] ] ] ]}}"
    type="2"
    value="{{fqbshow}}"
    vueId="1de1c492-31"
    wx:if="{{fqbInfo}}"
  ></tcyhq>
  <yszc
    bind:__l="__l"
    bind:close="__e"
    class="data-v-98d38686"
    data-event-opts="{{[ [ '^close',[ ['e2'] ] ] ]}}"
    value="{{fwxyshow}}"
    vueId="1de1c492-32"
    wx:if="{{system.yszz&&system.yszz==1}}"
  ></yszc>
  <footc bind:__l="__l" class="data-v-98d38686" vueId="1de1c492-33"></footc>
  <tab-bar bind:__l="__l" class="data-v-98d38686" vueId="1de1c492-34"></tab-bar>
  <load
    bind:__l="__l"
    class="data-v-98d38686"
    vueId="1de1c492-35"
    wx:if="{{showloading}}"
  ></load>
</view>
