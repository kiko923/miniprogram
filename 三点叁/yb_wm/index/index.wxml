  <sus-btn
    bind:__l="__l"
    class="data-v-98d38686"
    co="{{layout.susBtn[0].styles}}"
    vueId="1de1c492-28"
    wx:if="{{layout.susBtn&&layout.susBtn[0]}}"
  ></sus-btn>
  <view
    class="data-v-98d38686"
    wx:for="{{layout.remind}}"
    wx:for-index="i"
    wx:for-item="v"
    wx:key="i"
