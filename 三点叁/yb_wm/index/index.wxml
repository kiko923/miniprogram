<view
  class="pb115 o-h data-v-98d38686"
  style="{{'background:'+(layout.pageSetting?layout.pageSetting[0].styles.moduleTitle==1?layout.pageSetting[0].styles.colorIcon:'url('+layout.pageSetting[0].styles.img+')':'')+';'}}"
>
  <open-list
    bind:__l="__l"
    class="data-v-98d38686"
    co="{{layout.open[0].styles}}"
    vueId="1de1c492-1"
    wx:if="{{layout.open&&layout.open[0]}}"
  ></open-list>
  <uni-nav-bar
    bg="{{layout.pageSetting[0].styles.colorBg}}"
    bind:__l="__l"
    border="{{false}}"
    class="data-v-98d38686"
    color="{{layout.pageSetting[0].styles.colorWord}}"
    fixed="{{true}}"
    id="uninavbar"
    isleft="{{false}}"
    ispr="{{true}}"
    statusBar="{{true}}"
    title="{{layout.pageSetting[0].styles.navTitle}}"
    uropcity="1"
    vueId="1de1c492-2"
    wx:if="{{layout.pageSetting[0].styles.modulePage==1}}"
  ></uni-nav-bar>
  <atten-tion
    bind:__l="__l"
    class="data-v-98d38686"
    co="{{v.styles}}"
    vueId="{{'1de1c492-3-'+i}}"
    wx:if="{{v.name=='attention'&&v.styles.status==1}}"
    wx:for="{{layout.attention}}"
    wx:for-index="i"
    wx:for-item="v"
    wx:key="i"
  ></atten-tion>
  <block wx:for="{{layout.list}}" wx:for-index="i" wx:for-item="v" wx:key="i">
    <search-box
      bind:__l="__l"
      class="data-v-98d38686"
      co="{{v.styles}}"
      vueId="{{'1de1c492-4-'+i}}"
      wx:if="{{v.name=='search'}}"
    ></search-box>
    <block wx:else>
      <fixed-set
        bind:__l="__l"
        class="data-v-98d38686"
        co="{{v.styles}}"
        vueId="{{'1de1c492-5-'+i}}"
        wx:if="{{v.name=='fixed'}}"
      ></fixed-set>
      <block wx:else>
        <notice-sue
          bind:__l="__l"
          class="data-v-98d38686"
          co="{{v.styles}}"
          shopinfo="{{shopinfo}}"
          vueId="{{'1de1c492-6-'+i}}"
          wx:if="{{v.name=='notice'}}"
        ></notice-sue>
        <block wx:else>
          <pic-lunbo-by
            bind:__l="__l"
            class="data-v-98d38686"
            co="{{v.styles}}"
            vueId="{{'1de1c492-7-'+i}}"
