.container {
  background: #fff;
  font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen, Ubuntu, Cantarell, Open Sans, Helvetica Neue, sans-serif;
  min-height: 100vh;
  padding: 32rpx
}

.content {
  background: #f9f9fc;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
  padding: 32rpx
}

.title {
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 48rpx;
  padding-bottom: 24rpx;
  position: relative;
  text-align: center
}

.title::after {
  background: linear-gradient(90deg, #005bea, #00c6fb);
  border-radius: 3rpx;
  bottom: 0;
  content: "";
  height: 6rpx;
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
  width: 80rpx
}

.section {
  animation: fadeIn .5s ease-out;
  margin-bottom: 48rpx
}

@-webkit-keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx)
  }

  to {
    opacity: 1;
    transform: translateY(0)
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx)
  }

  to {
    opacity: 1;
    transform: translateY(0)
  }
}

.section-title {
  align-items: center;
  color: #333;
  display: -webkit-flex;
  display: flex;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx
}

.section-title::before {
  background: #005bea;
  border-radius: 4rpx;
  content: "";
  display: inline-block;
  height: 32rpx;
  margin-right: 16rpx;
  width: 8rpx
}

.platform-list {
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx
}

.platform-list text {
  background: #eef4ff;
  border-radius: 30rpx;
  color: #555;
  font-size: 26rpx;
  padding: 10rpx 20rpx
}

.step-list {
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  gap: 28rpx
}

.step {
  color: #555;
  font-size: 30rpx;
  line-height: 1.6;
  padding-left: 60rpx;
  position: relative
}

.step::before {
  align-items: center;
  background: #005bea;
  border-radius: 50%;
  color: #fff;
  content: attr(data-step);
  display: -webkit-flex;
  display: flex;
  font-size: 24rpx;
  font-weight: 700;
  height: 44rpx;
  justify-content: center;
  left: 0;
  position: absolute;
  top: 0;
  width: 44rpx
}

.link {
  background: #f0f7ff;
  border-left: 8rpx solid #005bea;
  border-radius: 16rpx;
  color: #005bea;
  font-size: 30rpx;
  margin: 24rpx 0;
  padding: 28rpx;
  position: relative;
  transition: all .3s;
  word-break: break-all
}

.link:active {
  background: #e6f0ff;
  transform: scale(.98)
}

.copy-text {
  background: rgba(0, 91, 234, .1);
  border-radius: 20rpx;
  color: #005bea;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  position: absolute;
  right: 24rpx
}

.tips {
  align-items: flex-start;
  background: #fff7e6;
  border-radius: 16rpx;
  color: #fa8c16;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 48rpx;
  padding: 28rpx
}

.tips::before {
  background: #fa8c16;
  border-radius: 50%;
  color: #fff;
  content: "!";
  display: inline-block;
  flex-shrink: 0;
  font-weight: 700;
  height: 36rpx;
  line-height: 36rpx;
  margin-right: 16rpx;
  text-align: center;
  width: 36rpx
}

.float-home-btn {
  align-items: center;
  background: linear-gradient(135deg, #005bea, #00c6fb);
  border-radius: 50%;
  bottom: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 91, 234, .3);
  display: -webkit-flex;
  display: flex;
  height: 96rpx;
  justify-content: center;
  position: fixed;
  right: 32rpx;
  transition: all .3s;
  width: 96rpx;
  z-index: 100
}

.float-home-btn:active {
  box-shadow: 0 3rpx 10rpx rgba(0, 91, 234, .2);
  transform: scale(.9)
}

.home-icon {
  height: 48rpx;
  width: 48rpx
}

.loading-container,
web-view {
  height: 100%;
  width: 100%
}

.loading-container {
  align-items: center;
  background-color: hsla(0, 0%, 100%, .9);
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: center;
  left: 0;
  position: absolute;
  top: 0;
  z-index: 100
}

.loading-spinner {
  animation: spin 1s linear infinite;
  border: 6rpx solid #f3f3f3;
  border-radius: 50%;
  border-top-color: #3498db;
  height: 64rpx;
  width: 64rpx
}

.loading-text {
  color: #666;
  font-size: 28rpx;
  margin-top: 20rpx
}

.error-container {
  align-items: center;
  background-color: #fff;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 100
}

.error-text {
  color: #333;
  font-size: 32rpx;
  margin: 30rpx 0;
  padding: 0 60rpx;
  text-align: center
}

.retry-btn {
  background-color: #1890ff;
  border: none;
  border-radius: 8rpx;
  color: #fff;
  font-size: 28rpx;
  margin-top: 20rpx;
  padding: 16rpx 40rpx
}

@-webkit-keyframes spin {
  0% {
    transform: rotate(0deg)
  }

  100% {
    transform: rotate(1turn)
  }
}

@keyframes spin {
  0% {
    transform: rotate(0deg)
  }

  100% {
    transform: rotate(1turn)
  }
}

@media (prefers-color-scheme:dark) {
  .container {
    background: #1a1a1a
  }

  .content {
    background: #2d2d2d;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .2)
  }

  .section-title,
  .title {
    color: #fff
  }

  .section-title::before {
    background: #4096ff
  }

  .platform-list text {
    background: #313e59;
    color: #eee
  }

  .step {
    color: #bbb
  }

  .step::before {
    background: #4096ff
  }

  .link {
    background: #253047;
    border-left-color: #4096ff;
    color: #4096ff
  }

  .link:active {
    background: #1e2738
  }

  .copy-text {
    background: rgba(64, 150, 255, .15);
    color: #4096ff
  }

  .tips {
    background: #2b2111;
    color: #ffc069
  }

  .tips::before {
    background: #ffc069;
    color: #2b2111
  }

  .float-home-btn {
    background: linear-gradient(135deg, #4096ff, #00c6fb)
  }

  .loading-container {
    background-color: rgba(30, 30, 30, .9)
  }

  .loading-text {
    color: #aaa
  }

  .error-container {
    background-color: #1a1a1a
  }

  .error-text {
    color: #ddd
  }
}