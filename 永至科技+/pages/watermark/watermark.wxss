/**index.wxss - Element Plus风格**/

/* 全局样式 */
page {
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.page-container {
  height: 100vh;
}

.main-content {
  padding: 32rpx;
  min-height: 100vh;
}

/* 信息卡片 */
.info-card {
  background: #000000;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.info-header {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.info-content {
  flex: 1;
}

.info-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.info-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

/* 卡片通用样式 */
.upload-card, .action-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 0;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.card-badge {
  background: #000000;
  color: white;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

/* 上传区域 */
.upload-zone {
  margin: 0 32rpx 32rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 12rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  transition: all 0.3s ease;
  background: #fafbfc;
}

.upload-zone:active {
  border-color: #000000;
  background: #f8f9fa;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon-large {
  margin-bottom: 24rpx;
}

.icon-bg {
  width: 120rpx;
  height: 120rpx;
  background: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.icon-text {
  font-size: 60rpx;
  color: white;
  font-weight: 300;
}

.upload-main-text {
  font-size: 32rpx;
  color: #303133;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-sub-text {
  font-size: 26rpx;
  color: #909399;
  line-height: 1.4;
}

/* 图片预览网格 */
.image-preview-grid {
  padding: 0 32rpx 32rpx;
}

.grid-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #606266;
}

.clear-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  border: 1rpx solid #e0e0e0;
}

.clear-icon {
  margin-right: 8rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-card {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 12rpx;
}

.image-card:active .image-overlay {
  opacity: 1;
}

.remove-button {
  width: 48rpx;
  height: 48rpx;
  background: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.remove-icon {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 主要按钮 */
.action-card {
  padding: 32rpx;
}

/* 水印类型选择 */
.watermark-type-section {
  margin-bottom: 32rpx;
}

.type-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #303133;
  margin-bottom: 20rpx;
}

.type-options {
  display: flex;
  gap: 32rpx;
}

.type-option {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e4e7ed;
  background: #ffffff;
  transition: all 0.3s ease;
  flex: 1;
  justify-content: center;
}

.type-option.selected {
  border-color: #000000;
  background: #f8f9fa;
}

.option-radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.type-option.selected .option-radio {
  border-color: #000000;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  background: #000000;
  border-radius: 50%;
}

.option-text {
  font-size: 26rpx;
  color: #606266;
  font-weight: 500;
}

.type-option.selected .option-text {
  color: #000000;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  margin: 0;
  padding: 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-button::after {
  border: none;
}

.primary-button.enabled {
  background-color: #07c160;
  color: #ffffff;
}

.primary-button.disabled {
  background-color: #f2f2f2;
  color: #c9c9c9;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top: 3rpx solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 进度浮动提示 - 居中显示 */
.progress-float {
  position: fixed;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
  animation: fadeInDown 0.3s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

/* 进度容器 */
.progress-container {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  padding: 40rpx;
  min-width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 进度图标包装器 */
.progress-icon-wrapper {
  margin-bottom: 24rpx;
}

.progress-icon {
  font-size: 64rpx;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { 
    transform: translateY(0) scale(1); 
  }
  50% { 
    transform: translateY(-10rpx) scale(1.1); 
  }
}

/* 进度内容 */
.progress-content {
  width: 100%;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.progress-count {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  background: #f0f9ff;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 进度条包装器 */
.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.progress-bar-track {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160 0%, #38d98c 100%);
  border-radius: 8rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.progress-bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.progress-text {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 700;
  min-width: 80rpx;
  text-align: right;
}

/* 进度提示文字 */
.progress-tip {
  text-align: center;
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
