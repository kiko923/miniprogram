    background: #3d3d3d
  }

  .result-section {
    background: #2d2d2d;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .2)
  }

  .content-text {
    background: #3d3d3d;
    color: #fff
  }

  .modal-content {
    background: #2d2d2d
  }

  .modal-header {
    border-bottom: 1rpx solid #3d3d3d;
    color: #fff
  }

  .modal-body {
    color: #999
  }

  .modal-footer {
    border-top: 1rpx solid #3d3d3d
  }

  .modal-btn {
    background: #2d2d2d
  }

  .modal-btn.cancel {
    border-right: 1rpx solid #3d3d3d;
    color: #999
  }

  .image-item {
    background: #3d3d3d
  }

  .floating-tip {
