  padding: 0 32rpx
}

.shortcut-link {
  color: #4096ff;
  font-size: 26rpx;
  font-weight: 400;
  padding: 10rpx 0
}

.copyright-text,
.shortcut-link {
  line-height: 1.5;
  text-align: center
}

.copyright-text {
  color: #aaa;
  font-size: 22rpx;
  margin-top: 5rpx
}

.selection-header {
  align-items: center;
  background: rgba(0, 0, 0, .03);
  border-radius: 6rpx;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-bottom: 4rpx;
  padding: 6rpx 8rpx
}

.selection-count {
  color: #333;
  font-size: 24rpx;
  font-weight: 500
}

.selection-actions {
  align-items: center;
  display: -webkit-flex;
  display: flex
}

.select-all-btn {
  background: rgba(0, 91, 234, .1);
  border-radius: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 91, 234, .1);
  color: #005bea;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 4rpx 10rpx
}

@media (prefers-color-scheme:dark) {
  .selection-header {
    background: hsla(0, 0%, 100%, .05)
  }

  .selection-count {
    color: #eee
  }

  .select-all-btn {
    background: rgba(64, 150, 255, .15);
    color: #4096ff
  }
}

.content-text-container {
  align-items: center;
  background: #f9f9f9;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  margin: 12rpx 0 24rpx;
  padding: 10rpx 12rpx;
  width: 100%
}

.content-text-input {
  background: transparent;
  border: none;
  box-sizing: border-box;
  color: #666;
  flex: 1;
  font-size: 24rpx;
  height: 60rpx;
  min-width: 0;
  overflow: hidden;
  padding: 0 12rpx;
  text-overflow: ellipsis;
  white-space: nowrap
}

.content-text-copy {
  background: rgba(64, 150, 255, .1);
  border-radius: 25rpx;
  color: #4096ff;
  flex-shrink: 0;
  font-size: 22rpx;
  height: 50rpx;
  line-height: 50rpx;
  margin-left: 8rpx;
  min-width: 80rpx;
  padding: 0 16rpx;
  text-align: center;
  transition: all .2s
}

.content-text-copy:active {
  opacity: .7
}

@media (prefers-color-scheme:dark) {
  .content-text-container {
    background: #252525
  }

  .content-text-input {
    color: #aaa
  }

  .content-text-copy {
    background: rgba(64, 150, 255, .15);
    color: #4096ff
  }
}

.single-image-container {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  margin: 0 auto;
  overflow: hidden;
  padding: 20rpx 0;
  width: 100%
}

.single-image {
  border-radius: 12rpx;
  display: block;
  height: 300rpx !important;
  max-width: 100%;
  object-fit: contain;
  width: 300rpx !important
}

.result-section .isSensitivePlatform .single-image-container .single-image {
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .15);
  height: 300rpx !important;
  margin: 30rpx auto;
  width: 300rpx !important
}

/* 视频容器样式 */
.single-content {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
}

.single-content video {
  width: 100%;
  max-height: 800rpx;
  border-radius: 12rpx;
  object-fit: contain;
}

/* 单张图片样式 */
.single-content .single-image {
  width: 100%;
  max-height: 800rpx;
  border-radius: 12rpx;
  object-fit: contain;
}

/* 图片网格样式 */
.image-grid-wrapper {
  width: 100%;
}

.image-grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 10rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
}

.image-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8rpx;
}

/* 选择框样式 */
.image-checkbox {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
}

.checkbox-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #999;
}

.checkbox-inner.checked {
  background: #4cb4f9;
  border-color: #4cb4f9;
}

.video-controls {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.control-btn {
  background: linear-gradient(135deg, #4cb4f9, #4cb4f9);
  border-radius: 35rpx;
  color: #fff;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin: 0 10rpx;
  padding: 0 30rpx;
  border: none;
}

.control-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

@media (prefers-color-scheme: dark) {
  .control-btn {
    background: linear-gradient(135deg, #1a4a99, #0080a3);
  }
}