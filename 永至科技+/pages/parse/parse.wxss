page {
  background: #f8f8f8;
  color: #333;
  flex-direction: column;
  font-size: 28rpx;
  height: 100vh;
  line-height: 1.5
}

.container,
page {
  display: -webkit-flex;
  display: flex
}

.container {
  background: #f8f9fa;
  box-sizing: border-box;
  flex: 1;
  padding: 20rpx
}

.container,
.header {
  flex-direction: column
}

.header {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-shrink: 0;
  margin-bottom: 24rpx;
  text-align: center
}

.title {
  color: #005bea;
  display: inline-block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  position: relative
}

.title::after {
  background: linear-gradient(90deg, #00c6fb, #005bea);
  border-radius: 2rpx;
  bottom: -4rpx;
  content: "";
  height: 4rpx;
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
  width: 40rpx
}

.subtitle {
  color: #666;
  font-size: 25rpx;
  letter-spacing: 1rpx;
  line-height: 1.5
}

.input-hint {
  display: none
}

.input-section {
  align-items: center;
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: none;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  margin-bottom: 0;
  padding: 32rpx 24rpx;
  width: 710rpx
}

.input-box {
  margin-bottom: 12rpx;
  position: relative;
  width: 100%
}

.url-input {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .12);
  box-sizing: border-box;
  font-size: 28rpx;
  height: 106rpx;
  padding: 0 122rpx 0 32rpx;
  width: 100%
}

.url-input::-webkit-input-placeholder {
  color: #999
}

.url-input::placeholder {
  color: #999
}

.action-btn {
  align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: -webkit-flex;
  display: flex;
  font-size: 28rpx;
  font-weight: 500;
  height: 106rpx;
  justify-content: center;
  padding: 0;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  transition: all .3s ease;
  width: 112rpx
}

.action-btn.paste {
  color: #05a89d
}

.action-btn.clear,
.action-btn.paste {
  border-bottom-left-radius: 0;
  border-top-left-radius: 0
}

.action-btn.clear {
  color: #ff9292
}

.action-btn:active {
  opacity: .8;
  transform: translateY(-50%) scale(.95)
}

.parse-btn-img {
  height: 40rpx;
  margin-right: 12rpx;
  width: 40rpx
}

.parse-btn {
  align-items: center;
  background: linear-gradient(135deg, #4cb4f9, #4cb4f9);
  border-radius: 45rpx;
  box-shadow: 0 6rpx 16rpx rgba(76, 180, 249, .15), 0 0 16rpx rgba(76, 180, 249, .2);
  color: #fff;
  display: -webkit-flex;
  display: flex;
  font-size: 32rpx;
  font-weight: 600;
  height: 90rpx;
  justify-content: center;
  letter-spacing: 4rpx;
  overflow: hidden;
  position: relative;
  width: 100%
}

.parse-btn:active {
  box-shadow: 0 4rpx 10rpx rgba(0, 91, 234, .15);
  transform: translateY(2rpx)
}

.parse-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx
}

.parse-btn::after {
  animation: shineEffect 3s infinite;
  background: linear-gradient(90deg, hsla(0, 0%, 100%, 0)0, hsla(0, 0%, 100%, .5) 50%, hsla(0, 0%, 100%, 0));
  content: "";
  height: 100%;
  left: -150%;
  position: absolute;
  top: 0;
  transform: skewX(-25deg);
  width: 60%
}

@-webkit-keyframes shineEffect {
  0% {
    left: -150%
  }

  100%,
  20% {
    left: 150%
  }
}

@keyframes shineEffect {
  0% {
    left: -150%
  }

  100%,
  20% {
    left: 150%
  }
}

.result-section {
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .05);
  box-sizing: border-box;
  flex-direction: column;
  height: 900rpx;
  margin: 0 auto;
  overflow: hidden;
  padding: 20rpx;
  width: 710rpx
}

.result-header,
.result-section {
  display: -webkit-flex;
  display: flex
}

.result-header {
  align-items: center;
  border-bottom: 1rpx solid #e6e1ff;
  justify-content: space-between;
  padding: 16rpx 24rpx
}

.platform-tag {
  background: rgba(138, 126, 255, .1);
  border-radius: 6rpx;
  color: #8a7eff;
  font-size: 24rpx;
  padding: 4rpx 12rpx
}

.close-btn {
  align-items: center;
  border-radius: 50%;
  color: #999;
  display: -webkit-flex;
  display: flex;
  font-size: 36rpx;
  height: 48rpx;
  justify-content: center;
  transition: all .2s ease;
  width: 48rpx
}

.close-btn:active {
  background: rgba(0, 0, 0, .05);
  color: #666
}

.content-text,
.image-grid-wrapper,
.video-container {
  margin: 20rpx
}

.video-container {
  border-radius: 12rpx;
  margin: 0 auto 24rpx;
  overflow: hidden;
  position: relative;
  width: 100%
}

.video-container video {
  display: block;
  width: 100%;
  z-index: 1
}

.copy-btn,
.result-title,
.save-video-btn {
  display: none
}

.media-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx
}

.media-item {
  border-radius: 8rpx;
  overflow: hidden;
  padding-bottom: 100%;
  position: relative
}

.media-img {
  height: 100%;
  object-fit: cover;
  position: absolute;
  width: 100%
}

.empty-result {
  margin-top: 20px
}

.shortcut-wrapper {
  margin-bottom: 15px
}

.shortcut-link {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  text-decoration: none
}

.copyright-text {
  color: #999;
  font-size: 12px
}

.empty-result {
  color: #bcbcbc;
  font-size: 22rpx;
  padding: 32rpx;
  text-align: center
}

.input-area {
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  padding: 20rpx
}

.input-title {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  text-align: center
}

.input-wrapper {
  background: #f8f8f8;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  padding: 20rpx
}

.action-bar {
  flex-wrap: wrap
}

.action-bar,
.auto-paste {
  align-items: center;
  display: -webkit-flex;
  display: flex
}

.auto-paste {
  margin-left: auto
}

.auto-paste text {
  color: #666;
  font-size: 26rpx;
  margin-right: 10rpx
}

.main-btn {
  background: #07c160;
  border-radius: 40rpx;
  color: #fff;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-bottom: 20rpx;
  width: 100%
}

.result-area {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx
}

.text-area {
  border-bottom: 1rpx solid #eee;
  display: -webkit-flex;
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx
}

.text-area text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  margin-right: 20rpx
}

.video {
  height: 400rpx;
  margin-bottom: 20rpx;
  width: 100%
}

.image-list {
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
  margin: 0-10rpx
}

.image-list image {
  border-radius: 6rpx;
  height: 200rpx;
  margin: 10rpx;
  width: calc(33.33% - 20rpx)
}

.save-btn {
  background: #07c160;
  border-radius: 35rpx;
  color: #fff;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin-top: 10rpx;
  width: 100%
}

.action-buttons {
  bottom: 24rpx;
  gap: 16rpx;
  justify-content: space-between;
  left: 0;
  margin: 0 auto;
  padding: 24rpx 32rpx;
  position: fixed;
  right: 0;
  width: 90%;
  z-index: 100
}

.action-buttons,
.primary-btn {
  align-items: center;
  display: -webkit-flex;
  display: flex
}

.primary-btn {
  background: linear-gradient(135deg, #ff6b6b, #f36);
  border-radius: 44rpx;
  box-shadow: 0 6rpx 16rpx hsla(0, 100%, 71%, .25);
  color: #fff;
  flex: 3;
  font-size: 28rpx;
  font-weight: 500;
  height: 88rpx;
  justify-content: center;
  transition: all .2s ease
}

.primary-btn:active {
  box-shadow: 0 3rpx 8rpx hsla(0, 100%, 71%, .2);
  transform: translateY(2rpx)
}

.secondary-btn {
  align-items: center;
  background: #65d678;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 16rpx rgba(101, 214, 120, .2);
  color: #fff;
  display: -webkit-flex;
  display: flex;
  flex: 1;
  font-size: 26rpx;
  font-weight: 400;
  height: 88rpx;
  justify-content: center;
  transition: all .2s ease
}

.secondary-btn:active {
  box-shadow: 0 3rpx 8rpx rgba(101, 214, 120, .15);
  opacity: .9;
  transform: translateY(2rpx)
}

.bottom-space {
  height: 120rpx
}

@media (prefers-color-scheme:dark) {
  .image-item {
    background: #2d2d2d
  }

  .content-text {
    background: #3d3d3d;
    color: #fff
  }
}

.video-container .wx-video-fullscreen+.action-buttons {
  display: none
}

.modal-mask {
  align-items: center;
  background: rgba(0, 0, 0, .6);
  bottom: 0;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  width: 600rpx
}

.modal-header {
  border-bottom: 1rpx solid #eee;
  color: #333;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx;
  text-align: center
}

.modal-body {
  color: #666;
  font-size: 28rpx;
  padding: 32rpx 24rpx;
  text-align: center
}

.modal-footer {
  border-top: 1rpx solid #eee;
  display: -webkit-flex;
  display: flex
}

.modal-btn {
  background: #fff;
  border: none;
  flex: 1;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center
}

.modal-btn.cancel {
  border-right: 1rpx solid #eee;
  color: #666
}

.modal-btn.confirm {
  display: block;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  text-align: center
}

@media (prefers-color-scheme:dark) {
  .shortcut-link {
    color: #4096ff
  }
}

.modal-btn.confirm {
  color: #005bea;
  font-weight: 500
}

.modal-btn::after {
  border: none
}

.image-count-tip {
  background: #f8f9fa;
  color: #666;
  font-size: 26rpx;
  margin: 16rpx 0;
  text-align: center
}

.floating-tip,
.image-count-tip {
  border-radius: 8rpx;
  padding: 16rpx 24rpx
}

.floating-tip {
  animation: fadeInOut 3s ease forwards;
  background: rgba(0, 0, 0, .7);
  bottom: 120rpx;
  color: #fff;
  font-size: 24rpx;
  left: 50%;
  pointer-events: none;
  position: absolute;
  transform: translateX(-50%);
  white-space: nowrap;
  z-index: 10
}

@-webkit-keyframes fadeInOut {
  0% {
    opacity: 0;
    transform: translate(-50%, 20rpx)
  }

  10% {
    opacity: 1;
    transform: translate(-50%, 0)
  }

  80% {
    opacity: 1;
    transform: translate(-50%, 0)
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -20rpx)
  }
}

.share-modal {
  align-items: center;
  background: rgba(0, 0, 0, .7);
  bottom: 0;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000
}

.share-content {
  animation: modalIn .3s ease-out;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .2);
  max-height: 90vh;
  max-width: 650rpx;
  overflow-y: auto;
  padding-bottom: 30rpx;
  position: relative;
  width: 86%
}

.share-close {
  align-items: center;
  color: #999;
  display: -webkit-flex;
  display: flex;
  font-size: 44rpx;
  font-weight: 300;
  height: 50rpx;
  justify-content: center;
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 50rpx;
  z-index: 2
}

.share-title {
  color: #333;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  margin-top: 40rpx;
  text-align: center
}

.share-desc {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  text-align: center
}

.coupons-list {
  padding: 0 20rpx
}

.coupon-item:active {
  background: #f0f0f0;
  transform: scale(.98)
}

.coupon-icon {
  border-radius: 10rpx;
  flex-shrink: 0;
  height: 72rpx;
  margin-right: 14rpx;
  width: 72rpx
}

.coupon-info {
  flex: 1;
  min-width: 0
}

.coupon-name {
  color: #333;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 6rpx
}

.coupon-desc,
.coupon-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap
}

.coupon-desc {
  color: #ff5757;
  font-size: 22rpx
}

.share-btns {
  padding: 20rpx 30rpx 10rpx
}

.share-btn::after {
  border: none
}

@media (prefers-color-scheme:dark) {
  .share-content {
    background: #2d2d2d
  }

  .share-title {
    color: #fff
  }

  .share-desc {
    color: #999
  }

  .coupon-item {
