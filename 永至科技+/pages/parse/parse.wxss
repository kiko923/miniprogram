}

.section-title {
  border-left: 8rpx solid #005bea;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  margin: 30rpx 0 20rpx;
  padding-left: 20rpx
}

.parse-btn-container {
  align-items: center;
  background: transparent;
  box-shadow: none;
  display: -webkit-flex;
  display: flex;
  flex: 3;
  height: 120rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  position: relative
}

.parse-btn-container::after {
  border: none
}

.feature-btn {
  align-items: center;
  background: linear-gradient(135deg, #f0f4ff, #e6edff);
  border-radius: 36rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .08);
  color: #3b76e3;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  flex: 1;
  font-size: 22rpx;
  font-weight: 500;
  height: 90rpx;
  justify-content: center;
  max-width: 100rpx;
  min-width: 0;
  padding: 0 8rpx;
  transition: all .3s ease;
  width: 100rpx
}

.feature-btn:active {
  opacity: .9;
  transform: translateY(2rpx) scale(.98)
}

.btn-icon {
  font-size: 24rpx;
  margin-bottom: 4rpx
}

.btn-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap
}

.button-group {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  gap: 60rpx;
  height: 120rpx;
  justify-content: space-between;
  margin-top: 24rpx;
  position: relative;
  width: 100%
}

.banner-image {
  display: block;
  height: calc(50vw*259/1024);
  margin: 0 auto 32rpx;
  width: 90vw
}

.content-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%
}

.scroll-content {
  box-sizing: border-box;
  padding: 12rpx
}

.image-grid-wrapper {
  margin: 0 auto 24rpx;
  position: relative;
  width: 100%
}

.image-grid-container {
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  flex-wrap: wrap;
  padding: 6rpx
}

.image-item {
  background: #f5f5f5;
  border-radius: 8rpx;
  margin: 6rpx;
  width: calc(33.33% - 12rpx)
}

.image-item::before {
  content: "";
  display: block;
  padding-top: 100%
}

.image-item image {
  height: 100%;
  left: 0;
  object-fit: cover;
  position: absolute;
  top: 0;
  width: 100%
}

.content-text {
  background: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  margin: 0 auto 24rpx;
  padding: 24rpx;
  white-space: pre-wrap;
  width: 100%;
  word-break: break-all
}

@media (prefers-color-scheme:dark) {
  .feature-btn {
    background: linear-gradient(135deg, #2a3555, #223049);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .15);
    color: #6ba0ff
  }
}

.preview-guide {
  animation: fadeInOut 3s ease-in-out forwards;
  background: rgba(0, 0, 0, .7);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .3);
  left: 50%;
  padding: 30rpx;
  pointer-events: none;
  position: fixed;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999
}

.guide-content {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column
}

.guide-icon {
  color: #fff;
  font-size: 40rpx;
  margin-bottom: 8rpx
}

.guide-text {
  color: #fff;
  font-size: 26rpx;
  margin-bottom: 20rpx
}

@keyframes fadeInOut {
  0% {
    opacity: 0
  }

  20% {
    opacity: 1
  }

  80% {
    opacity: 1
  }

  100% {
    opacity: 0
  }
}

.image-item {
  overflow: hidden;
  position: relative
}

.image-checkbox {
  align-items: center;
  background: hsla(0, 0%, 100%, .7);
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  height: 40rpx;
  justify-content: center;
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 40rpx;
  z-index: 2
}

.checkbox-inner {
  background: transparent;
  border-radius: 50%;
  height: 24rpx;
  transition: all .2s;
  width: 24rpx
}

.checkbox-inner.checked {
  background: #005bea
}

@media (prefers-color-scheme:dark) {
  .image-checkbox {
    background: rgba(50, 50, 50, .8);
    border-color: #444
  }

  .checkbox-inner.checked {
    background: #4096ff
  }
}

@-webkit-keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(.8)
  }

  to {
    opacity: 1;
    transform: scale(1)
  }
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(.8)
  }

  to {
    opacity: 1;
    transform: scale(1)
  }
}

