  }
}

.test-image-section {
  display: none
}

.full-width-btn {
  align-items: center !important;
  background-color: #3498db !important;
  border-radius: 40rpx !important;
  box-shadow: 0 8rpx 16rpx rgba(52, 152, 219, .3) !important;
  color: #fff !important;
  display: -webkit-flex !important;
  display: flex !important;
  font-size: 32rpx !important;
  justify-content: center !important;
  line-height: 80rpx !important;
  margin: 0 auto !important;
  padding: 0 !important;
  width: 80% !important
}

.loading-mask {
  background: rgba(0, 0, 0, .6);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1001
}

.loading-content,
.loading-mask {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center
}

.loading-content {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .15);
  flex-direction: column;
  padding: 40rpx 60rpx
}

.loading-spinner {
  animation: spin 1s linear infinite;
  border: 6rpx solid #f3f3f3;
  border-radius: 50%;
  border-top-color: #005bea;
  height: 80rpx;
  margin-bottom: 24rpx;
  width: 80rpx
}

.loading-text {
  color: #333;
  font-size: 30rpx;
  font-weight: 500
}

@-webkit-keyframes spin {
  0% {
    transform: rotate(0deg)
  }

  100% {
    transform: rotate(1turn)
  }
}

@keyframes spin {
  0% {
    transform: rotate(0deg)
  }

  100% {
    transform: rotate(1turn)
  }
}

.coupons-row {
  display: -webkit-flex;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 20rpx
}

.coupon-item {
  background: #f8f8f8;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .05);
  padding: 16rpx;
  transition: -webkit-transform .2s ease;
  transition: transform .2s ease;
  transition: transform .2s ease, -webkit-transform .2s ease;
  width: calc(50% - 8rpx)
}

.coupon-item,
.share-btn {
  align-items: center;
  display: -webkit-flex;
  display: flex
}

.share-btn {
  background: linear-gradient(135deg, #005bea, #00c6fb);
  border-radius: 40rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  height: 80rpx;
  justify-content: center;
  line-height: 80rpx;
  margin-top: 10rpx
}

@media (prefers-color-scheme:dark) {
  .loading-content {
    background: #2d2d2d
  }

  .loading-spinner {
    border: 6rpx solid #444;
    border-top-color: #4096ff
  }

  .loading-text {
    color: #fff
  }
}

.footer-info {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
