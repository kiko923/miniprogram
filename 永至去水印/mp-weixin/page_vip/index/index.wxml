<view style="overflow-x:hidden;"><view class="bg"><image class="bg-img" src="/page_vip/static/bg.png" mode></image></view><view class="nav" style="{{'padding-top:'+(statusBarHeight+'px')+';'}}"><image class="nav-back" src="/page_vip/static/back.png" mode data-event-opts="{{[['tap',[['back',['$event']]]]]}}" bindtap="__e"></image><text class="nav-title"></text><view class="nav-space"></view></view><view class="info" style="{{'margin-top:'+(statusBarHeight+44+'px')+';'}}"><image class="info-bg" src="/page_vip/static/info-bg.png" mode></image><view class="info-content"><view class="info-avatar"><image class="info-avatar-pic" style="border-radius:50%;" src="{{userInfo.avatarUrl||logo}}" mode></image></view><view class="info-name"><text class="info-name">{{userInfo.nickName||'勇敢的西红柿'}}</text><block wx:if="{{userInfo.kami_time<dq_time}}"><text class="info-level">升级超级会员享额外特权</text></block><block wx:else><text class="info-level">{{''+$root.g0+' 到期'}}</text></block></view></view><view class="info-asset"><view class="info-asset-item"><text class="iai-title">金币</text><text class="iai-value">{{userInfo.money||0}}</text></view><view class="info-asset-item"><text class="iai-title">解析次数</text><text class="iai-value">{{userInfo.number||0}}</text></view></view></view><view class="main-title"><text>超级会员充值</text></view><scroll-view scroll-x="{{true}}"><view class="recharge"><block wx:for="{{rechargeOptions}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['rechargeChange',[index]]]]]}}" class="{{['recharge-item',current==index?'recharge-item-active':'']}}" style="{{'margin-left:'+(!index?'30rpx':'')+';'}}" bindtap="__e"><block wx:if="{{item.showTag}}"><view class="recharge-tag"><text class="recharge-tag-text">限时特价</text></view></block><text class="recharge-item-duration">{{item.duration}}</text><view class="recharge-item-price"><text class="rmb">￥</text><text class="recharge-item-price-text">{{item.price}}</text></view></view></block></view></scroll-view><view class="button update text-white" hover-class="hover" data-event-opts="{{[['tap',[['updateNow',['$event']]]]]}}" bindtap="__e"><text class="button-text text-white">立即购买/续费</text></view><text class="tip">购买成功后自动到账</text><view class="main-title"><text>会员特权</text></view><view class="privilege"><block wx:for="{{privilegeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="privilege-item" hover-class="hover" data-event-opts="{{[['tap',[['privilegeClick',[index]]]]]}}" bindtap="__e"><image class="privilege-item-pic" src="{{item.pic}}" mode></image><text class="privilege-item-text">{{item.text}}</text></view></block></view></view>